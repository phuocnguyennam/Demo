  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!--
              Docker Engine 25+ removed Docker API versions below 1.40, but the
              docker-java client shaded inside Testcontainers 1.19.8 still defaults
              to API 1.32. Without this, Testcontainers aborts with:
                "client version 1.32 is too old. Minimum supported API version is 1.40"
              Testcontainers reads this system property via DockerClientConfig (key
              "api.version"). 1.44 is the highest version its RemoteApiVersion knows.
            -->
            <api.version>1.44</api.version>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
